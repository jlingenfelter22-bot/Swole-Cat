{
  "name": "swole-cat",
  "version": "0.65.1",
  "private": true,
  "description": "Swole Cat workout tracker PWA and Android app",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "android:prepare": "node scripts/prepare-android.mjs",
    "android:sync": "npm run android:prepare",
    "android:open": "npm run android:prepare && npx cap open android",
    "android:debug": "node scripts/build-android.mjs debug",
    "android:release": "node scripts/build-android.mjs release"
  },
  "swoleCat": {
    "androidVersionCode": 79
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/app": "8.0.0",
    "@capacitor/keyboard": "8.0.0",
    "@capacitor/status-bar": "8.0.0",
    "@capacitor/filesystem": "8.0.0",
    "@capacitor/share": "8.0.0",
    "@capacitor-community/speech-recognition": "7.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@capacitor/assets": "3.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}

{
  "appId": "com.jlingenfelter.swolecat.testing",
  "appName": "Swole Cat Testing",
  "webDir": "www",
  "server": {
    "hostname": "localhost",
    "androidScheme": "https"
  },
  "android": {
    "backgroundColor": "#0b0e14",
    "allowMixedContent": false
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "css"
    },
    "Keyboard": {
      "resize": "native",
      "resizeOnFullScreen": true
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#0b0e14",
      "overlaysWebView": true
    }
  }
}
